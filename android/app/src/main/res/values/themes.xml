<?xml version="1.0" encoding="utf-8"?>
<!-- <resources>: the wrapper element for any values resource file. -->
<resources>
    <!-- Fullscreen, no action bar — this is a display surface, not a normal app. -->
    <!-- <style name="Theme.UsbDisplay" ...>: defines the app's theme (referenced
         from AndroidManifest's android:theme).
           parent=Theme.AppCompat.DayNight.NoActionBar
             -> inherit AppCompat's light/dark theme, but with NO title/action bar. -->
    <style name="Theme.UsbDisplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- windowNoTitle=true  -> no title bar at the top of the window. -->
        <item name="android:windowNoTitle">true</item>
        <!-- windowFullscreen=true -> draw edge-to-edge with no system chrome. -->
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
