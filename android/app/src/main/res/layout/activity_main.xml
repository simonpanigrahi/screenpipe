<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen has four stacked layers (FrameLayout draws later children on top):
    1. SurfaceView   — the decoded video. Centered; its size is adjusted at
                       runtime for aspect-fit (letterboxing) unless "Stretch" is on.
    2. status        — the big centered "Waiting for stream…" message.
    3. stats         — a small top-left overlay (resolution / state), toggleable.
    4. controls      — a bottom control bar with the feature toggles. Hidden by
                       default; tap anywhere to show it, and it auto-hides.

  (XML can't carry comments between attributes, so each element is explained in
  the comment block directly above it.)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- SurfaceView: the dedicated video surface MediaCodec renders onto.
           layout_gravity="center" -> stays centered when resized for aspect-fit. -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- status: the large centered connection message, shown until frames flow. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Waiting for stream…"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <!-- stats: small diagnostics overlay in the top-left corner.
           visibility="gone" -> hidden until the "Stats" toggle turns it on.
           background=translucent black -> readable over any video. -->
    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="#99000000"
        android:textColor="#FF80FF80"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:text="" />

    <!-- controls: the bottom toggle bar.
           visibility="gone" -> hidden until the user taps the screen.
           background=translucent black -> a readable panel over the video.
           The buttons inside are wired up and re-labelled in MainActivity. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#B3000000"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnConnect"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="Disconnect" />

        <Button
            android:id="@+id/btnFit"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="Fit: On" />

        <Button
            android:id="@+id/btnStats"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="Stats: Off" />

        <Button
            android:id="@+id/btnAwake"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:text="Awake: On" />
    </LinearLayout>
</FrameLayout>
